@model List<SphotoApp.Web.Models.ExcelTemplate>
@{ ViewData["Title"]="Excel Template"; }
<div class="card"><form asp-action="Upload" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input name="Name" placeholder="Tên template" required/><input name="File" type="file" accept=".xlsx" required/><input name="TargetStartRow" type="number" value="2"/><button class="btn btn-primary">Upload template mới</button></form></div><div class="card"><table class="table"><tbody>@foreach(var t in Model){<tr><td>@t.Name</td><td>@t.FileName</td><td>@(t.IsActive?"Đang dùng":"")</td></tr>}</tbody></table></div>
