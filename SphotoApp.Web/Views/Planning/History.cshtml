@model List<SphotoApp.Web.Models.DownloadHistory>
@{ ViewData["Title"]="Lịch sử tải"; }
<div class="card"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Lịch sử tải</h5><form asp-action="ClearHistory" method="post" onsubmit="return confirm('Xóa toàn bộ lịch sử tải?');">@Html.AntiForgeryToken()<button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Xóa toàn bộ lịch sử</button></form></div><table class="table"><thead><tr><th>Thời gian</th><th>File nguồn</th><th>File kết quả</th><th>Bản ghi</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var h in Model){<tr><td>@h.StartedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@h.SourceFileName</td><td>@h.OutputFileName</td><td>@h.RecordCount</td><td>@h.Status</td></tr>}</tbody></table></div>
