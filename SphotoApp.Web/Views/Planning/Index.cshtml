@{ ViewData["Title"]="Planning"; }
<div class="card planning-card"><div class="planning-top"><div><h2>Tải dữ liệu Planning</h2><p>Hệ thống kiểm tra đăng nhập EPP trước, sau đó mới tải và xử lý file.</p><form id="download-form">@Html.AntiForgeryToken()<button id="download-button" class="btn btn-primary btn-lg"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> <span id="button-label">TẢI DỮ LIỆU EPP</span></button></form></div><div id="status" class="planning-progress" aria-live="polite"></div></div><div id="preview"></div></div>
@section Scripts { <script>
const form=document.querySelector('#download-form'),button=document.querySelector('#download-button'),spinner=button.querySelector('.spinner-border'),label=document.querySelector('#button-label'),status=document.querySelector('#status'),previewArea=document.querySelector('#preview'),token=document.querySelector('input[name=__RequestVerificationToken]').value;
function state(text,kind='pending'){status.insertAdjacentHTML('beforeend',`<div class="epp-state ${kind}"><i class="bi ${kind==='success'?'bi-check-circle-fill':kind==='error'?'bi-x-circle-fill':'bi-arrow-repeat'}"></i>${text}</div>`)}
async function post(url){const r=await fetch(url,{method:'POST',headers:{RequestVerificationToken:token}});return await r.json()}
function previewTable(data,id){const panel=document.createElement('div');panel.className='card mt-4 p-0 overflow-hidden';const title=document.createElement('div');title.className='p-3 border-bottom d-flex justify-content-between align-items-center';title.innerHTML='<div><strong>Xem trước file kết quả</strong><div class="text-muted small">Hiển thị khoảng 20 dòng; kéo để xem toàn bộ '+data.totalRecords+' dòng.</div></div>';const download=document.createElement('a');download.className='btn btn-primary';download.href='/Planning/File?id='+id;download.innerHTML='<i class="bi bi-download"></i> TẢI FILE KẾT QUẢ';title.appendChild(download);const wrapper=document.createElement('div');wrapper.className='preview-scroll';const table=document.createElement('table');table.className='table table-sm mb-0 preview-table';const thead=document.createElement('thead'),headRow=document.createElement('tr');data.headers.forEach((h,index)=>{const cell=document.createElement('th');cell.className='preview-col-'+index;cell.textContent=h;headRow.appendChild(cell)});thead.appendChild(headRow);table.appendChild(thead);const tbody=document.createElement('tbody');data.rows.forEach(row=>{const tr=document.createElement('tr');row.forEach((value,index)=>{const td=document.createElement('td');td.className='preview-col-'+index;td.textContent=value;tr.appendChild(td)});tbody.appendChild(tr)});table.appendChild(tbody);wrapper.appendChild(table);panel.append(title,wrapper);previewArea.replaceChildren(panel)}
form.onsubmit=async e=>{e.preventDefault();button.disabled=true;spinner.classList.remove('d-none');label.textContent='ĐANG KIỂM TRA...';status.innerHTML='';previewArea.innerHTML='';try{state('Đang kết nối EPP Portal...');const login=await post('@Url.Action("Test","EppConfig")');if(!login.success){state(login.message,'error');return}state('Đăng nhập EPP thành công.','success');label.textContent='ĐANG TẢI DỮ LIỆU...';state('Đang mở trang Planning và bấm Download...');const result=await post('@Url.Action("Download")');if(!result.success){state(result.message,'error');return}state('Đã tải Excel, đang tạo bản xem trước...','success');state(result.driveError?'Google Drive: '+result.driveError:'Google Drive: đã lấy được '+result.driveLinksFound+'/'+result.driveLookups+' link thư mục.',result.driveError?'error':'success');state('Email: đã lấy được '+result.emailLinksFound+' link dự phòng.','success');const data=await (await fetch('/Planning/Preview?id='+result.historyId)).json();state('Đã mapping xong. Kiểm tra dữ liệu trước khi tải file.','success');previewTable(data,result.historyId)}catch{state('Không thể kết nối tới SphotoApp. Vui lòng thử lại.','error')}finally{button.disabled=false;spinner.classList.add('d-none');label.textContent='TẢI DỮ LIỆU EPP'}};
</script> }
