@model List<SphotoApp.Web.Models.Customer>
@{ ViewData["Title"]="Quản lý khách hàng"; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card"><div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#customerModal"><i class="bi bi-plus-lg"></i> Thêm khách hàng</button></div>
<div class="d-flex gap-2 mb-3"><input id="customer-search" class="form-control" placeholder="Tìm theo tên khách hàng..." style="max-width:320px"/><select id="customer-page-size" class="form-select" style="max-width:120px"><option value="10">10 / trang</option><option value="20" selected>20 / trang</option><option value="50">50 / trang</option></select></div>
<div class="table-responsive"><table id="customer-table" class="table table-hover align-middle customer-table"><thead><tr><th style="width:60px">STT</th><th>Tên khách hàng</th><th>Yêu cầu</th><th>Ghi chú</th><th class="text-end">Thao tác</th></tr></thead><tbody>@{var customerIndex=0;}@foreach(var c in Model){customerIndex++;<tr><td class="text-muted">@customerIndex</td><td class="customer-name">@c.Name</td><td class="customer-text">@c.Requirement</td><td class="customer-text">@c.Note</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-secondary customer-view" data-name="@c.Name" data-requirement="@c.Requirement" data-note="@c.Note" data-bs-toggle="modal" data-bs-target="#customerModal">Xem</button> <button type="button" class="btn btn-sm btn-outline-primary customer-edit" data-id="@c.Id" data-name="@c.Name" data-requirement="@c.Requirement" data-note="@c.Note" data-bs-toggle="modal" data-bs-target="#customerModal">Sửa</button> <form class="d-inline" asp-action="Delete" method="post" onsubmit="return confirm('Xóa khách hàng này?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>}</tbody></table></div><div id="customer-pages" class="btn-group mt-3"></div></div>
<div class="modal fade" id="customerModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="customer-form" asp-action="Save" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" id="customer-id" value="0"/><div class="modal-header"><h5 id="customer-modal-title" class="modal-title">Thêm khách hàng</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label>Tên khách hàng</label><input name="Name" id="customer-name" class="form-control" required/></div><div class="mb-3"><label>Yêu cầu</label><textarea name="Requirement" id="customer-requirement" class="form-control" rows="4"></textarea></div><label>Ghi chú</label><textarea name="Note" id="customer-note" class="form-control" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button id="customer-save" class="btn btn-primary">Lưu</button></div></form></div></div></div>
@section Scripts { <script>const rows=[...document.querySelectorAll('#customer-table tbody tr')],search=document.querySelector('#customer-search'),size=document.querySelector('#customer-page-size'),pages=document.querySelector('#customer-pages');let page=1;function render(){const q=(search.value||'').toLowerCase(),filtered=rows.filter(r=>r.cells[1].textContent.toLowerCase().includes(q)),n=+size.value,total=Math.max(1,Math.ceil(filtered.length/n));page=Math.min(page,total);rows.forEach(r=>r.style.display='none');filtered.slice((page-1)*n,page*n).forEach((r,i)=>{r.style.display='';r.cells[0].textContent=(page-1)*n+i+1});pages.innerHTML='';pages.style.display='flex';for(let i=1;i<=total;i++){const b=document.createElement('button');b.className='btn btn-sm '+(i===page?'btn-primary':'btn-outline-primary');b.textContent=i;b.onclick=()=>{page=i;render()};pages.appendChild(b)}}search.oninput=()=>{page=1;render()};size.onchange=()=>{page=1;render()};render();document.querySelectorAll('.customer-edit,.customer-view').forEach(b=>b.onclick=()=>{const edit=b.classList.contains('customer-edit');document.querySelector('#customer-modal-title').textContent=edit?'Sửa khách hàng':'Xem khách hàng';document.querySelector('#customer-id').value=edit?(b.dataset.id||0):0;document.querySelector('#customer-name').value=b.dataset.name||'';document.querySelector('#customer-requirement').value=b.dataset.requirement||'';document.querySelector('#customer-note').value=b.dataset.note||'';['#customer-name','#customer-requirement','#customer-note'].forEach(s=>document.querySelector(s).readOnly=!edit);document.querySelector('#customer-save').classList.toggle('d-none',!edit)});</script> }
